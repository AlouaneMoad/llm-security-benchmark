# Global Target Models Gateway Configuration
OPENAI_BASE_URL=https://your-api-gateway-endpoint.com/v1
OPENAI_API_KEY=your_openai_or_gateway_api_key_here

# Target Models (comma-separated list of models to benchmark)
TARGET_MODELS=deepseek-v4-flash-0731,deepseek-v4-pro-0813,glm-5.3-flash,glm-5.3,kimi-k2.6,kimi-k3,MiniMax-M3,MiniMax-M2.7,qwen3.8-flash,mimo-v2.6-pro,mimo-v2.6-flash,hy3,hy4-preview,gpt-6-luna,gpt-5.6-terra,gpt-5.6-sol,claude-sonnet-5,gemini-3.8-flash,grok-4.6,claude-opus-5,gpt-6-sol,claude-fable-5,qwen3.8-max,gpt-6-astra,claude-opus-4-8,gemini-3.7-flash

# Dedicated Judge Endpoint & API Key Routing Configuration
JUDGE_MODEL=gemini-3.8-flash-high
USE_SEPARATE_JUDGE_CONFIG=true
JUDGE_BASE_URL=http://localhost:8080/v1
JUDGE_API_KEY=your_judge_api_key_here

# Benchmark Concurrency & Timeout
MAX_CONCURRENCY=5
REQUEST_TIMEOUT=60.0
